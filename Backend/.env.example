# SEEK Backend - Environment Variables Template
# Copy this to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ============================================
# GEMINI AI Configuration
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ============================================
# MongoDB Configuration
# ============================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/empathy_db
MONGODB_DB=empathy_for_learning

# ============================================
# JWT / Security Configuration
# ============================================
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_very_long_random_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS Configuration
# ============================================
# Add your frontend URLs here (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]

# ============================================
# API Server Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Application Configuration
# ============================================
DEBUG=False
LOG_LEVEL=INFO

# ============================================
# Optional: Advanced Configuration
# ============================================
# Gemini model to use (leave blank for default)
# GEMINI_MODEL=gemini-2.5-flash

# Max chat history per user
# MAX_CHAT_HISTORY=1000

# Enable RAG/FAISS features
# USE_FAISS=True

# Email notifications (if implemented)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SENDER_EMAIL=noreply@seekplatform.com
